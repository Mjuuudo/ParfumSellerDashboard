        "description": "create table \"StockReservation\"",
        "sql": "CREATE TABLE \"public\".\"StockReservation\" (\n  \"consumedAt\" timestamptz,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"decantBottleId\" int4,\n  \"id\" SERIAL NOT NULL,\n  \"orderItemId\" int4 NOT NULL,\n  \"quantity\" int4,\n  \"quantityMl\" int4,\n  \"releasedAt\" timestamptz,\n  \"status\" text DEFAULT 'RESERVED' NOT NULL,\n  \"stockBatchId\" int4,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"StockReservation_status_check_4f928414\" CHECK (\"status\" IN ('RESERVED', 'CONSUMED', 'RELEASED')),\n  CONSTRAINT \"stockreservation_one_source_5172c28e\" CHECK ((\"stockBatchId\" IS NOT NULL AND \"quantity\" IS NOT NULL AND \"quantity\" > 0 AND \"decantBottleId\" IS NULL AND \"quantityMl\" IS NULL) OR (\"decantBottleId\" IS NOT NULL AND \"quantityMl\" IS NOT NULL AND \"quantityMl\" > 0 AND \"stockBatchId\" IS NULL AND \"quantity\" IS NULL))\n)",
        "params": []
      }
    ],
    "postcheck": [
