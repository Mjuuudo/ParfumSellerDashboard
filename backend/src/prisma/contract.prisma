// use prisma-8

enum RoleEnum {
  OWNER
  EMPLOYEE
}

enum OrderStatus {
  COMFIRMED
  PENDING
  CANCELLED
  DELIVERD
}

enum ParfumType {
  COMPLETE
  DECANT_10ML
  DECANT_20ML
}

enum DecantOpperationType {
  CONSUMPTION
  REVERSAL
}

// Lifecycle of a StockReservation:
// RESERVED (order pending) → CONSUMED (order confirmed, stock deducted)
//                          → RELEASED (order cancelled; consumedAt set too if it had been confirmed and was reversed)
enum ReservationStatus {
  RESERVED
  CONSUMED
  RELEASED
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  firstName String
  lastName String
  email String @unique
  phoneNumber String
  passwordHash String
  Role  RoleEnum
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  lastLoginAt DateTime?
  lastUpdate temporal.updatedAt()
  createdOrders Order[] @relation("OrderCreator")
  verifiedOrders Order[] @relation("OrderVerifier")
  cancelledOrders Order[] @relation("OrderCanceller")
  stockBatches StockBatch[]
  decantBottle DecantBottle[] @relation("BottleReservation")
  decanteOpperations DecantOpperation[]
}

model Customer{
  id Int @id @default(autoincrement())
  fullName String
  email String
  phoneNumber String
  address String
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  order Order[]
}

model DeliveryCompany{
  id Int @id @default(autoincrement())
  name String
  delivreyPrice Int
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  lastUsedAt DateTime?

  order Order[]
}

model Order{
  id Int @id @default(autoincrement())
  deliveryAdress String
  deliveryPrice Int?
  status OrderStatus @default(PENDING)
  pendingAt DateTime @default(now())
  verifiedAt DateTime?
  delivredAt DateTime?
  cancelledAt DateTime?
  updatedAt temporal.updatedAt()

  createdBy Int
  userCreator User @relation("OrderCreator", fields: [createdBy], references: [id])

  verifiedBy Int?
  userVerifier User? @relation("OrderVerifier", fields: [verifiedBy], references: [id])

  cancelledBy Int?
  userCanceller User? @relation("OrderCanceller", fields: [cancelledBy], references: [id])

  customerId Int
  customer Customer @relation(fields: [customerId], references: [id])

  deliveryCompanyId Int?
  deliveryCompany DeliveryCompany? @relation(fields: [deliveryCompanyId], references: [id])

  orderItems OrderItem[]
  decantOpperations DecantOpperation[]
  
}

model OrderItem{
  id Int @id @default(autoincrement())
  sellingType ParfumType
  quantity Int
  unitPrice Int
  totalPrice Int

  orderId Int
  order Order @relation(fields: [orderId], references: [id])

  parfumId Int
  parfum Parfum @relation(fields: [parfumId], references: [id])

  orderItemsConsumptions OrderitemConsumption[]
  stockReservations StockReservation[]

  @@check(expression: "\"quantity\" > 0 AND \"unitPrice\" >= 0 AND \"totalPrice\" >= 0", name: "orderitem_positive_amounts")
}

// One allocation of stock to an order item: either N sealed bottles of a StockBatch (COMPLETE)
// or N ml of an opened DecantBottle (DECANT_10ML / DECANT_20ML). Exactly one source is set.
model StockReservation{
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  stockBatchId Int?
  stockBatch StockBatch? @relation(fields: [stockBatchId], references: [id])
  quantity Int?

  decantBottleId Int?
  decantBottle DecantBottle? @relation(fields: [decantBottleId], references: [id])
  quantityMl Int?

  status ReservationStatus @default(RESERVED)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()
  consumedAt DateTime?
  releasedAt DateTime?

  @@check(expression: "(\"stockBatchId\" IS NOT NULL AND \"quantity\" IS NOT NULL AND \"quantity\" > 0 AND \"decantBottleId\" IS NULL AND \"quantityMl\" IS NULL) OR (\"decantBottleId\" IS NOT NULL AND \"quantityMl\" IS NOT NULL AND \"quantityMl\" > 0 AND \"stockBatchId\" IS NULL AND \"quantity\" IS NULL)", name: "stockreservation_one_source")
}

model OrderitemConsumption{
  id Int @id @default(autoincrement())
  
  orderItemId Int
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  decantBottleId Int
  decantBottle DecantBottle @relation(fields:[decantBottleId], references:[id])

  quantityMl Int
  consumedAt DateTime @default(now())
}

model Brand{
  id Int @id @default(autoincrement())
  name String @unique
  image String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  parfums Parfum[]
}


model Parfum{
  id Int @id @default(autoincrement())
  name String

  brandId Int
  brand Brand @relation(fields: [brandId], references: [id])

  originalVolume Int
  completePrice Int 
  decant10Price Int
  decant20Price Int
  isActive Boolean @default(true)

  orderItems OrderItem[]
  stockBatch StockBatch[]
  decantBottles DecantBottle[]
  @@unique([brandId, name, originalVolume])
}

model StockBatch{
  id Int @id @default(autoincrement())

  parfumId Int
  parfum Parfum @relation(fields: [parfumId], references: [id])

  quantity Int
  unusedQuantity Int
  // Sealed bottles held for pending orders. Available = unusedQuantity - reservedQuantity.
  reservedQuantity Int @default(0)
  purchaseCostPerBottle Int
  receivedAt DateTime @default(now())

  receivedBy Int
  receivedByUser User @relation(fields: [receivedBy], references: [id])

  decantBottles DecantBottle[]
  stockReservations StockReservation[]

  @@check(expression: "\"unusedQuantity\" >= 0 AND \"reservedQuantity\" >= 0 AND \"reservedQuantity\" <= \"unusedQuantity\"", name: "stockbatch_reservation_bounds")
}


model DecantBottle{
  id Int @id @default(autoincrement())


  parfumId Int
  parfum Parfum @relation(fields:[parfumId], references:[id])

  stockBatchId Int
  stockBatch StockBatch @relation(fields:[stockBatchId], references:[id])

  initialVolumeMl Int
  remainingVolumeMl Int
  // Millilitres held for pending orders. Available = remainingVolumeMl - reservedVolumeMl.
  reservedVolumeMl Int @default(0)
  reservedAt DateTime?

  reservedById Int?
  reservedBy User? @relation("BottleReservation", fields: [reservedById], references:[id])

  lastDecantedAt  DateTime?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt temporal.updatedAt()

  decantOpperation DecantOpperation[]
  orderItemConsumption OrderitemConsumption[]
  stockReservations StockReservation[]

  @@check(expression: "\"remainingVolumeMl\" >= 0 AND \"reservedVolumeMl\" >= 0 AND \"reservedVolumeMl\" <= \"remainingVolumeMl\" AND \"remainingVolumeMl\" <= \"initialVolumeMl\"", name: "decantbottle_volume_bounds")
}


model DecantOpperation{
  id Int @id @default(autoincrement())

  decantBottleId Int
  decantBottle DecantBottle @relation(fields: [decantBottleId], references:[id])

  employeeId Int
  employee User @relation(fields: [employeeId], references: [id])

  quantityMl Int

  orderId Int
  order Order @relation(fields:[orderId], references:[id])

  oppType DecantOpperationType @default(CONSUMPTION)
  reversedOperationId Int? @unique
  reversedOpperation DecantOpperation? @relation("OperationReversal", fields: [reversedOperationId], references: [id])
  reversedByOpperation DecantOpperation? @relation("OperationReversal")

  performedAt DateTime @default(now())
}

